@model Domain.ViewModel.Tenant.EditTenantViewModel
@{
    ViewData["Title"] = "ویرایش مستاجر";
}
<div class="container mt-4">
    <h2 class="text-primary mb-4">ویرایش مستاجر</h2>
    <form asp-action="EditTenant" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id"/>
        <div class="mb-3">
            <label asp-for="Name" class="form-label">نام و نام خانوادگی</label>
            <input asp-for="Name" class="form-control"/>
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Job" class="form-label">شغل</label>
            <input asp-for="Job" class="form-control"/>
            <span asp-validation-for="Job" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label">توضیحات</label>
            <input asp-for="Description" class="form-control"/>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>ذ
        <button type="submit" class="btn btn-primary">ذخیره تغییرات</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">بازگشت</a>
    </form>
</div>