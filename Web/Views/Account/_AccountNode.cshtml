@model Domain.ViewModel.Ledger.AccountTreeNodeViewModel

<li class="list-group-item">
    <div class="d-flex justify-content-between align-items-center">
        <span>@Model.AccountCode - @Model.Name</span>
        <div>
            <a asp-action="EditAccount" asp-route-id="@Model.Id" class="btn btn-sm btn-warning">ویرایش</a>
            <a asp-action="DeleteAccount" asp-route-id="@Model.Id" class="btn btn-sm btn-danger"
               onclick="return confirm('آیا از حذف حساب مطمئن هستید؟')">حذف</a>
        </div>
    </div>

    @if (Model.Children?.Any() == true)
    {
        <ul class="list-group mt-2 ms-3">
            @foreach (var child in Model.Children)
            {
                @await Html.PartialAsync("_AccountNode", child)
            }
        </ul>
    }
</li>